# 배포 환경 설정. 이 파일을 .env.deploy 로 복사해 값을 채운다.
#
#   docker compose \
#     -f docker-compose.yml \
#     -f docker-compose.deploy.yml \
#     --env-file .env.deploy up -d
#
# 이 스택은 DB 와 같은 호스트에서 돈다. 프론트는 버셀에 있고 이 서버는 API 만 낸다.

# ---------------------------------------------------------------------------
# DB. 같은 호스트의 PostgreSQL 에 붙는다.
#
# db 컨테이너가 PostgreSQL 이 아니라 TCP 중계로 호스트의 5432 로 넘긴다. 그래서 DB 주소를
# 여기 적지 않는다(컨테이너가 host-gateway 로 알아서 찾는다).
# ---------------------------------------------------------------------------
DB_NAME=aidocs
DB_USERNAME=aidocs
DB_PASSWORD=

# DB 연결의 app.encryption_key 세션 설정에 주입할 Base64 키.
# 이미 저장된 암호문이 이 키로 암호화돼 있다. 값이 바뀌면 복호화할 수 없으므로
# dev 에서 쓰는 값과 반드시 같아야 한다. 새로 만들면 안 된다.
DB_ENCRYPTION_KEY=

# 암호화 알고리즘. 비워 두면 ARIA-256 을 쓴다. Tmax OpenCrypto 가 설치된 환경이므로 비워 둔다.
DB_ENCRYPTION_CIPHER=

# ---------------------------------------------------------------------------
# 오브젝트 스토리지. 컨테이너 안에서의 엔드포인트는 http://minio:9000 이다.
# 원본 다운로드는 프론트가 MinIO 에 직접 붙지 않고 API 서버의
# /versions/{versionNo}/content 를 거치므로 MinIO 를 밖에 열지 않는다.
# ---------------------------------------------------------------------------
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=aidocs-documents

# 임베딩. 워커의 문서 인덱싱과 서버의 검색 질의 임베딩에 함께 쓴다.
OPENAI_API_KEY=

# 검색 결과 재정렬(Cohere Rerank, https://dashboard.cohere.com). 기본값으로 켜져 있다
# (검색 요청의 rerank 파라미터로 끌 수 있다). 이 키가 없으면 값과 무관하게 RRF 순서로
# 대체된다. Trial 키는 분당 10회 제한이라 실제 트래픽에는 Production 키가 필요하다.
COHERE_API_KEY=

# ---------------------------------------------------------------------------
# HTTPS.
#
# Let's Encrypt 는 IP 주소로 인증서를 발급하지 않으므로 도메인 이름이 필요하다. 도메인이
# 없으면 sslip.io 를 쓴다 — <대시로-구분한-IP>.sslip.io 가 그 IP 로 해석되는 공용 서비스다.
#
# 주의: 이 이름에 IP 가 들어 있다. Elastic IP 를 붙이지 않으면 서버를 재시작할 때 IP 가 바뀌고,
# 그러면 이 값과 인증서, 그리고 버셀의 VITE_API_BASE_URL 까지 모두 다시 맞춰야 한다.
# ---------------------------------------------------------------------------
PUBLIC_DOMAIN=43-201-101-133.sslip.io

# ---------------------------------------------------------------------------
# CORS 를 허용할 origin. 버셀 배포 주소를 적는다. 쉼표로 여러 개를 넘긴다.
# 프론트와 API 가 다른 origin 이므로 이 값이 틀리면 HTTPS 를 붙여도 브라우저가 막는다.
# 값이 없으면 앱이 뜨지 않는다(application.yml 에 기본값이 없다).
#   예) https://spr1n6-osscontest-web.vercel.app
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# 릴레이 관리 엔드포인트 토큰. 비워두면 인증 없이 열린다.
# 포트를 루프백에만 열더라도 값을 넣어 두는 편이 낫다.
RELAY_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 이미지. server 는 이 저장소에서 빌드하고, 릴레이와 워커는 GHCR 에서 받는다.
# 둘 다 linux/amd64 를 포함해야 한다(이 서버는 x86_64 다).
# ---------------------------------------------------------------------------
RELAY_IMAGE=ghcr.io/mash-up-kr/spr1n6-osscontest-relay:latest
WORKER_IMAGE=ghcr.io/mash-up-kr/spr1n6-osscontest-worker:latest

# ---------------------------------------------------------------------------
# 포트.
#
# 밖에 열리는 것은 caddy 의 80·443 뿐이다. 나머지는 바인드 주소를 붙여 루프백에 묶는다.
# 볼 일이 있으면 SSH 로컬 포워딩으로 본다.
#   ssh -L 9090:127.0.0.1:9090 -L 8081:127.0.0.1:8081 rocky@43.201.101.133
# ---------------------------------------------------------------------------
SERVER_HOST_PORT=127.0.0.1:8080
MINIO_HOST_PORT=127.0.0.1:9010
MINIO_CONSOLE_HOST_PORT=127.0.0.1:9011
KAFKA_HOST_PORT=127.0.0.1:29092
RELAY_HOST_PORT=127.0.0.1:9090
KAFKA_UI_HOST_PORT=8081