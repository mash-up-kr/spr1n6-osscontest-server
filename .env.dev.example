# dev 설정. 이 파일을 .env 로 복사해 값을 채운다.
# dev 스택(docker-compose.dev.yml)과 gradle 로 띄우는 dev 프로파일이 같은 파일을 읽는다.
#
#   docker compose -f docker-compose.dev.yml up -d --build      # dev 스택
#   ./scripts/tunnel.sh start                                   # gradle 로 띄울 때만
#   ./gradlew bootRun --args='--spring.profiles.active=dev'
#
# DB 는 db-03 을 거치는 SSH 터널로 DB 클러스터(OpenProxy VIP)에 붙는다.

# dev 스택의 DB 경로. 터널을 쓰면 그대로 둔다.
# VPN 으로 VPC 에 붙어 있으면 COMPOSE_PROFILES 를 비우고 COMPOSE_DB_HOST=10.40.1.100 으로 둔다.
COMPOSE_PROFILES=tunnel
COMPOSE_DB_HOST=
COMPOSE_DB_PORT=

# DB. 비밀번호와 암호화 키는 1:1 로 전달받는다.
DB_USERNAME=aidocs
DB_PASSWORD=
# app_user.name 과 document_version.original_filename 을 암호화하는 키. 트랜잭션마다 app.encryption_key 로 설정된다.
# 이미 저장된 암호문이 이 키로 암호화돼 있다. 새로 만들면 안 된다.
DB_ENCRYPTION_KEY=
# 비워 두면 ARIA-256 을 쓴다.
DB_ENCRYPTION_CIPHER=

# gradle 로 띄울 때만 쓴다. 터널의 로컬 끝(TUNNEL_LOCAL_PORT)을 가리킨다. DB_NAME 은 OpenProxy 풀 이름이다.
# VPN 으로 붙어 있으면 10.40.1.100 / 6432 로 둔다. dev 스택은 이 값을 읽지 않는다.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=aidocs_session

# SSH 터널. 키는 값이 아니라 파일 경로를 적고, 절대경로를 쓴다.
SSH_HOST=43.200.76.219
SSH_PORT=22
SSH_USER=rocky
SSH_KEY_PATH=
# 포워딩 대상. 서버 안에서 본 OpenProxy VIP 다. TUNNEL_LOCAL_PORT 는 tunnel.sh 만 쓴다.
TUNNEL_LOCAL_PORT=15432
TUNNEL_REMOTE_HOST=10.40.1.100
TUNNEL_REMOTE_PORT=6432

# 문서 인덱싱과 검색 질의의 임베딩(text-embedding-3-small, 1536차원)에 쓴다.
OPENAI_API_KEY=

# 오브젝트 스토리지. dev 스택의 MinIO 를 워커와 함께 쓴다.
# STORAGE_ENDPOINT 는 gradle 로 띄울 때만 읽는다(호스트에서 본 MinIO 주소).
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=aidocs
STORAGE_SECRET_KEY=aidocs1234
STORAGE_BUCKET=aidocs-documents

# CORS 를 허용할 origin. 쉼표로 여러 개를 넘긴다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 아래는 모두 선택이다. 비워 두면 괄호 안의 값이 들어간다.
# ---------------------------------------------------------------------------

# 검색 결과 재정렬(Cohere Rerank, https://dashboard.cohere.com). 이 키가 없으면 RRF 순서로 대체된다.
COHERE_API_KEY=

# dev 스택의 호스트 포트. (8080 / 9010 / 9011)
SERVER_HOST_PORT=
MINIO_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=

# 워커 이미지. 비워 두면 워커 저장소가 올린 latest 를 쓴다.
WORKER_IMAGE=
