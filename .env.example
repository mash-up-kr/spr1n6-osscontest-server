# dev 프로파일 접속 정보. 이 파일을 .env로 복사해 값을 채운다.

# DB. SSH 터널을 거치므로 호스트는 로컬이고, 포트는 TUNNEL_LOCAL_PORT와 같아야 한다.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# DB 연결의 app.encryption_key 세션 설정에 주입할, 따옴표 없는 고엔트로피 Base64 키.
DB_ENCRYPTION_KEY=

# SSH 터널. 키는 값이 아니라 파일 경로를 적고, 절대경로나 ~/로 시작하는 경로를 쓴다.
SSH_HOST=
SSH_PORT=
SSH_USER=
SSH_KEY_PATH=

# 포워딩 구간. 원격 호스트는 서버 안에서 본 DB 주소다.
TUNNEL_LOCAL_PORT=15432
TUNNEL_REMOTE_HOST=127.0.0.1
TUNNEL_REMOTE_PORT=5432

# 오브젝트 스토리지. 컨테이너 안에서 부를 때는 호스트가 localhost 가 아니라 서비스 이름이다.
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=aidocs-documents

# 검색 질의를 text-embedding-3-small(1536차원)로 변환할 때 사용한다.
OPENAI_API_KEY=

# CORS 를 허용할 origin. 쉼표로 여러 개를 넘긴다. 값이 없으면 앱이 뜨지 않는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 암호화 알고리즘. 비워 두면 ARIA-256 을 쓴다. ARIA 가 없는 DB 에서만 aes256 으로 바꾼다.
DB_ENCRYPTION_CIPHER=
