# 전체 스택 설정. 이 파일을 .env 로 복사해 쓴다.
#
#   docker compose up -d --build
#
# 채워야 하는 값은 OPENAI_API_KEY 하나다. 나머지는 비워 두면 컴포즈가 기본값을 넣는다.
# 기본값은 로컬에서 혼자 띄우는 것을 전제로 하므로, 밖에 노출되는 환경에서는 바꾼다.

# 문서 인덱싱과 검색 질의의 임베딩(text-embedding-3-small, 1536차원)에 쓴다.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 아래는 모두 선택이다. 비워 두면 괄호 안의 값이 들어간다.
# ---------------------------------------------------------------------------

# DB. 컨테이너로 함께 뜨므로 주소를 적지 않는다. (aidocs / aidocs / aidocs)
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# app_user.name 과 document_version.original_filename 을 암호화하는 키.
# 기본값은 로컬 전용이다. 값이 바뀌면 기존 암호문을 복호화할 수 없다.
DB_ENCRYPTION_KEY=

# 오브젝트 스토리지(MinIO). (aidocs / aidocs1234 / aidocs-documents)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# CORS 를 허용할 origin. 쉼표로 여러 개를 넘긴다. (http://localhost:5173)
CORS_ALLOWED_ORIGINS=

# 호스트 포트. (8080 / 9010 / 9011 / 29092 / 8081 / 9090)
SERVER_HOST_PORT=
MINIO_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=
KAFKA_HOST_PORT=
KAFKA_UI_HOST_PORT=
RELAY_HOST_PORT=

# 릴레이 관리 엔드포인트 토큰. 비워 두면 인증 없이 열린다.
RELAY_ADMIN_TOKEN=

# 이미지. server 는 이 저장소에서 빌드하고, 릴레이와 워커는 GHCR 에서 받는다.
# 비워 두면 각 저장소가 올린 latest 를 쓴다.
RELAY_IMAGE=
WORKER_IMAGE=
