#!/usr/bin/env bash
#
# DB HA 기능테스트 실행기. 저장소 루트에서 ./ha-test/ha-test <명령> 으로 부른다.
#
#   ./ha-test/ha-test status            노드별 역할·상태·Lag·VIP
#   ./ha-test/ha-test check             기준 상태만 검사(읽기 전용)
#   ./ha-test/ha-test H-3               H-3 시험 하나
#   ./ha-test/ha-test all               H-1~H-6 전부
#   ./ha-test/ha-test restore           기준 상태로 되돌리기
#   ./ha-test/ha-test unlock            강제로 끊긴 시험이 남긴 잠금 풀기
#
#   --simulate   서버 없이 모의 클러스터로 끝까지 돌려 본다
#   --yes        장애 주입 전 확인을 건너뛴다
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# -I 는 PYTHONPATH·현재 디렉터리·사용자 site 를 모두 무시한다. 그 격리를 유지하면서 이 도구의
# 패키지 경로 하나만 명시적으로 넣는다. 다른 데서 끼어드는 import 를 막기 위해서다.
exec env HA_TEST_HOME="$HERE" python3 -I -c \
  "import os,sys; sys.path.insert(0, os.environ['HA_TEST_HOME']); from hatest.cli import main; sys.exit(main())" "$@"
