# 통합 환경 설정. 이 파일을 .env.integration 으로 복사해 값을 채운다.
#
#   docker compose -f docker-compose.integration.yml --env-file .env.integration up -d
#
# 값 하나를 여러 서비스가 서로 다른 변수명으로 읽는다. 이름을 통일하지 않고
# 컴포즈에서 각 이미지가 원하는 이름으로 넘긴다.

# DB. 컨테이너 안에서는 호스트가 postgres 다.
DB_NAME=aidocs
DB_USERNAME=aidocs
DB_PASSWORD=aidocs
DB_ENCRYPTION_KEY=

# 오브젝트 스토리지. 컨테이너 안에서는 엔드포인트가 http://minio:9000 이다.
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=aidocs
STORAGE_SECRET_KEY=aidocs1234
STORAGE_BUCKET=aidocs-documents

# 임베딩. 워커가 문서를 인덱싱할 때 호출한다.
OPENAI_API_KEY=

# 릴레이 관리 엔드포인트 토큰. 비워두면 인증 없이 열린다.
RELAY_ADMIN_TOKEN=

# 이미지. 각 저장소가 Docker Hub 에 올린 이름과 태그를 적는다.
SERVER_IMAGE=
RELAY_IMAGE=
WORKER_IMAGE=

# 호스트 포트. 로컬 개발 환경(docker-compose.yml)과 겹치지 않게 기본값을 다르게 뒀다.
POSTGRES_HOST_PORT=5433
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
KAFKA_HOST_PORT=29092
SERVER_HOST_PORT=8080
